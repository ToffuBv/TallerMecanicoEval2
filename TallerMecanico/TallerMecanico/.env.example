# Plantilla de variables de entorno para ASP.NET Core, sin secretos reales.
# .NET no carga archivos .env automaticamente en este proyecto.
# Define estas variables en el entorno de ejecucion o usa appsettings.example.json
# como plantilla de appsettings.Development.json (excluido de Git).
# Los dobles guiones bajos representan secciones de configuracion de .NET.

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__miconexion="Server=TU_SERVIDOR;Database=TallerMecanicoDB;User Id=TU_USUARIO;Password=TU_CONTRASENA;Encrypt=True;TrustServerCertificate=True"
Jwt__Key=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=TallerMecanicoApi
Jwt__Audience=TallerMecanicoApiUsuarios
Cors__Origins__0=http://127.0.0.1:5173
Cors__Origins__1=http://localhost:5173

# Opcional: descomenta y reemplaza ambas contrasenas para crear cuentas de
# desarrollo al arrancar. Minimo 12 caracteres; no cambia cuentas existentes.
# Seed__AdminPassword=REEMPLAZAR_POR_CONTRASENA_PROPIA
# Seed__MecanicoPassword=REEMPLAZAR_POR_OTRA_CONTRASENA_PROPIA
